{
  "workers": {
    "local-fast": {
      "provider": "ollama",
      "model": "gemma4:grug",
      "type": "chat",
      "context_window": 16384,
      "target_context_tokens": 2048,
      "temperature": 0.3,
      "ollama_host": "http://localhost:11434",
      "ollama_timeout": 120,
      "num_keep": 1024,
      "thinking_mode": false,
      "concurrency": 1
    },
    "embedder": {
      "provider": "ollama",
      "model": "nomic-embed-text",
      "type": "embedding",
      "ollama_host": "http://localhost:11434",
      "ollama_timeout": 120,
      "concurrency": 4
    }
  },
  "dispatcher": {
    "worker_tier": "local-fast"
  },
  "agents": {
    "chat_agent": {
      "required_worker_tier": "local-fast",
      "prompt": "prompts/agents/chat_agent.md",
      "tools": "all",
      "rag_sources": ["core_memory"]
    }
  },
  "rag_sources": {
    "core_memory": {
      "db_path": "memory.db",
      "embedding_worker": "embedder"
    }
  },
  "memory": {
    "summary_days_limit": 7,
    "summary_token_budget": 300,
    "summarization_threshold_bytes": 100,
    "thread_history_limit": 10,
    "thread_idle_timeout_hours": 4,
    "idle_sweep_interval_minutes": 15,
    "capped_tail_lines": 100,
    "rag_result_limit": 3
  },
  "storage": {
    "base_dir": "./brain",
    "session_ttl_days": 30
  },
  "scheduler": {
    "poll_interval_seconds": 60,
    "db_file": "schedules.db",
    "timezone": "America/Los_Angeles"
  }
}
